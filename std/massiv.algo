amal massiv_teskari(arr) {
    n = uzunlik(arr)
    uchun i = 0; i < n / 2; i = i + 1 {
        j = n - 1 - i
        temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
    }
    qaytar arr
}

amal massiv_yigindi(arr) {
    n = uzunlik(arr)
    y = 0
    uchun i = 0; i < n; i = i + 1 {
        y = y + arr[i]
    }
    qaytar y
}

amal massiv_maksimum(arr) {
    n = uzunlik(arr)
    agar n == 0 {
        qaytar 0
    }
    m = arr[0]
    uchun i = 1; i < n; i = i + 1 {
        agar arr[i] > m {
            m = arr[i]
        }
    }
    qaytar m
}

amal massiv_minimum(arr) {
    n = uzunlik(arr)
    agar n == 0 {
        qaytar 0
    }
    m = arr[0]
    uchun i = 1; i < n; i = i + 1 {
        agar arr[i] < m {
            m = arr[i]
        }
    }
    qaytar m
}

amal massiv_qidir(arr, qiymat) {
    n = uzunlik(arr)
    uchun i = 0; i < n; i = i + 1 {
        agar arr[i] == qiymat {
            qaytar i
        }
    }
    qaytar -1
}

amal massiv_sarala(arr) {
    n = uzunlik(arr)
    uchun i = 0; i < n - 1; i = i + 1 {
        uchun j = 0; j < n - i - 1; j = j + 1 {
            agar arr[j] > arr[j + 1] {
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
    qaytar arr
}

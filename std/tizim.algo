// Algo Dasturlash Tili - Standart Tizim Kutubxonasi (std/tizim.algo)

amal muhit_ol(nom) {
    qaytar muhit(nom)
}

amal buyruq_bajar(buyruq) {
    qaytar tizim_buyruq(buyruq)
}

amal tasodifiy_son(min, max) {
    qaytar tasodifiy(min, max)
}

amal jarayon_raqami() {
    qaytar jarayon_id()
}

amal kutish_ms(ms) {
    qaytar kutish(ms)
}

amal kutish_sekund(sekund) {
    qaytar kutish(sekund * 1000)
}

amal dasturdan_chiq(kod) {
    chiqish(kod)
}

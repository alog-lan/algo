// Algo Dasturlash Tili - Standart Matematika Kutubxonasi (std/matematika.algo)

amal modul(son) {
    agar son < 0 {
        qaytar -son
    }
    qaytar son
}

amal maksimum(a, b) {
    agar a > b {
        qaytar a
    }
    qaytar b
}

amal minimum(a, b) {
    agar a < b {
        qaytar a
    }
    qaytar b
}

amal daraja(asos, daraja_son) {
    natija = 1
    uchun i = 0; i < daraja_son; i = i + 1 {
        natija = natija * asos
    }
    qaytar natija
}

amal pi() {
    qaytar 3.1415926535
}

amal e() {
    qaytar 2.7182818284
}

amal kvadrat_ildiz(x) {
    qaytar ildiz(x)
}

amal ekub(a, b) {
    x = a
    y = b
    agar x < 0 { x = -x }
    agar y < 0 { y = -y }
    toki y != 0 {
        t = y
        y = x % y
        x = t
    }
    qaytar x
}

amal ekuk(a, b) {
    agar a == 0 yoki b == 0 { qaytar 0 }
    e_val = ekub(a, b)
    qaytar (a * b) / e_val
}

amal faktorial(n) {
    agar n <= 1 { qaytar 1 }
    f = 1
    uchun i = 2; i <= n; i = i + 1 {
        f = f * i
    }
    qaytar f
}

amal tubmi(n) {
    agar n <= 1 { qaytar 0 }
    agar n <= 3 { qaytar 1 }
    agar n % 2 == 0 yoki n % 3 == 0 { qaytar 0 }
    i = 5
    toki i * i <= n {
        agar n % i == 0 yoki n % (i + 2) == 0 {
            qaytar 0
        }
        i = i + 6
    }
    qaytar 1
}

amal sinus(x) {
    x2 = x * x
    x3 = x * x2
    x5 = x3 * x2
    x7 = x5 * x2
    qaytar x - (x3 / 6.0) + (x5 / 120.0) - (x7 / 5040.0)
}

amal kosinus(x) {
    x2 = x * x
    x4 = x2 * x2
    x6 = x4 * x2
    qaytar 1.0 - (x2 / 2.0) + (x4 / 24.0) - (x6 / 720.0)
}

amal tangens(x) {
    s = sinus(x)
    c = kosinus(x)
    agar c == 0.0 { qaytar 0.0 }
    qaytar s / c
}

amal pol(x) {
    b = butun(x)
    agar x < 0.0 va haqiqiy(b) > x {
        qaytar b - 1
    }
    qaytar b
}

amal shift(x) {
    b = butun(x)
    agar x > 0.0 va haqiqiy(b) < x {
        qaytar b + 1
    }
    qaytar b
}

amal yaxlitla(x) {
    agar x >= 0.0 {
        qaytar butun(x + 0.5)
    } yoqsa {
        qaytar butun(x - 0.5)
    }
}

amal tasodifiy_oraliq(min, max) {
    agar min >= max { qaytar min }
    t = tasodifiy()
    agar t < 0 { t = -t }
    qaytar min + (t % (max - min + 1))
}

amal daraja_haqiqiy(asos, daraja_son) {
    natija = 1.0
    uchun i = 0; i < daraja_son; i = i + 1 {
        natija = natija * asos
    }
    qaytar natija
}

amal eksponenta(x) {
    term = 1.0
    yigindi = 1.0
    uchun i = 1; i <= 10; i = i + 1 {
        term = term * x / haqiqiy(i)
        yigindi = yigindi + term
    }
    qaytar yigindi
}

amal natural_logarifm(x) {
    agar x <= 0.0 { qaytar 0.0 }
    y = (x - 1.0) / (x + 1.0)
    y2 = y * y
    term = y
    yigindi = y
    uchun i = 1; i <= 7; i = i + 1 {
        term = term * y2
        daraja_k = haqiqiy(2 * i + 1)
        yigindi = yigindi + (term / daraja_k)
    }
    qaytar 2.0 * yigindi
}

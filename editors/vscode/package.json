{
  "name": "algo-lang",
  "displayName": "Algo Dasturlash Tili",
  "description": "O'zbek tilidagi birinchi ultra-tezkor dasturlash tili (.algo) uchun rasmiy kengaytma, sintaksis ranglari va 3D ikonkalar",
  "version": "1.5.0",
  "publisher": "alog-lan",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "keywords": [
    "algo",
    "uzbek",
    "dasturlash",
    "compiler",
    "language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alog-lan/algo.git"
  },
  "homepage": "https://github.com/alog-lan/algo",
  "contributes": {
    "languages": [
      {
        "id": "algo",
        "aliases": [
          "Algo",
          "algo"
        ],
        "extensions": [
          ".algo"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/algo.svg",
          "dark": "./icons/algo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "algo",
        "scopeName": "source.algo",
        "path": "./syntaxes/algo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "algo",
        "path": "./snippets/algo.json"
      }
    ],
    "iconThemes": [
      {
        "id": "algo-icons",
        "label": "Algo File Icons",
        "path": "./icons/algo-icon-theme.json"
      }
    ]
  }
}

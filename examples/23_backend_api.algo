yukla "std/tarmoq.algo"

amal asosiy() {
    port = 8080
    chiqar("==========================================")
    chiqar("    Algo REST API Backend Serveri (v1.0)  ")
    chiqar("==========================================")
    chiqar("Server 8080-portda ishga tushmoqda...")
    server_fd = tarmoq_server_och(port)

    agar server_fd <= 0 {
        chiqar("Xatolik: 8080-portni ochib bo'lmadi!")
        qaytar 1
    }

    chiqar("Server ulanishlarni qabul qilishga tayyor!")

    // 3 ta so'rovga xizmat ko'rsatib, testni yakunlaymiz
    so'rovlar_soni = 0
    toki so'rovlar_soni < 3 {
        mijoz_fd = tarmoq_mijoz_qabul(server_fd)
        agar mijoz_fd > 0 {
            so'rov = tarmoq_qabul(mijoz_fd, 2048)

            // Marshrutlash (Routing)
            agar matn_ichida(so'rov, "GET /api/holat ") {
                javob = "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\n\r\n{\"holat\": \"faol\", \"til\": \"Algo\", \"tezlik\": \"Godan tez\", \"xotira\": \"9KB\"}\n"
                tarmoq_yubor(mijoz_fd, javob)
                chiqar("[200 OK] GET /api/holat")
            } aks agar matn_ichida(so'rov, "GET /api/foydalanuvchi ") {
                javob = "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\n\r\n{\"id\": 1, \"ism\": \"Jasurbek\", \"kasb\": \"Backend Arxitektor\", \"til\": \"Algo\"}\n"
                tarmoq_yubor(mijoz_fd, javob)
                chiqar("[200 OK] GET /api/foydalanuvchi")
            } aks agar matn_ichida(so'rov, "GET / ") {
                javob = "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\n\r\n<h1>Algo Backend Serveriga Xush Kelibsiz!</h1><p>Ushbu backend toza x86_64 assemblerda ishlamoqda.</p>\n"
                tarmoq_yubor(mijoz_fd, javob)
                chiqar("[200 OK] GET /")
            } aks {
                javob = "HTTP/1.1 404 Not Found\r\nContent-Type: application/json\r\n\r\n{\"xato\": \"Sahifa topilmadi\"}\n"
                tarmoq_yubor(mijoz_fd, javob)
                chiqar("[404] Noma'lum so'rov")
            }

            tarmoq_yop(mijoz_fd)
            so'rovlar_soni = so'rovlar_soni + 1
        }
    }

    tarmoq_yop(server_fd)
    chiqar("Server xizmatni muvaffaqiyatli yakunladi.")
    qaytar 0
}

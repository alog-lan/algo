// ==============================================================================
// Algo Dasturlash Tili - Rasmiy Portal Veb-Serveri (sayt.algo)
// 100% Algo tilida yozilgan, mustaqil x86_64 Linux Direct Syscalls veb-serveri
// ==============================================================================

yukla "std/tarmoq.algo"
yukla "std/http.algo"
yukla "std/matn.algo"
yukla "std/fayl.algo"
yukla "std/rang.algo"
yukla "std/tizim.algo"

amal asosiy() {
    port = 8080
    
    chiqar(rang_turkuaz("╔══════════════════════════════════════════════════════════════════════╗"))
    chiqar(rang_turkuaz("║") + rang_qalin("  🚀 Algo Dasturlash Tili - Rasmiy Veb-Portali (v1.5.0)              ") + rang_turkuaz("║"))
    chiqar(rang_turkuaz("║") + "  100% Algo tilida yozilgan • Zero-Libc • Direct Linux Syscalls        " + rang_turkuaz("║"))
    chiqar(rang_turkuaz("╚══════════════════════════════════════════════════════════════════════╝"))
    
    server_fd = server_yarat(port)
    agar server_fd < 0 {
        chiqar(rang_qizil("Xatolik: Portni ochib bo'lmadi!"), port)
        qaytar 1
    }
    
    chiqar(rang_yashil("✓") + " Server tinglamoqda: " + rang_turkuaz("http://localhost:8080") + " yoki " + rang_turkuaz("http://127.0.0.1:8080"))
    chiqar(rang_sariq("!") + " Saytni ko'rish uchun brauzerda oching. To'xtatish: Ctrl+C\n")

    // Cheksiz mijozlarni qabul qilish sikli
    toki 1 == 1 {
        mijoz_fd = mijoz_kut(server_fd)
        agar mijoz_fd < 0 {
            davom
        }
        
        // Mijozdan so'rovni qabul qilamiz (4096 baytgacha)
        sorov = xabar_qabul(mijoz_fd, 4096)
        agar uzunlik(sorov) == 0 {
            ulanish_yop(mijoz_fd)
            davom
        }
        
        metod = http_metod(sorov)
        xom_yol = http_yol(sorov)
        
        // Query parametr (?v=...) ni kesib olamiz
        yol = xom_yol
        q_idx = matn_topish(xom_yol, "?")
        agar q_idx >= 0 {
            yol = matn_kesish(xom_yol, 0, q_idx)
        }
        
        chiqar(rang_turkuaz("[HTTP]") + " " + rang_qalin(metod) + " " + yol)
        
        // Marshrutlash (Routing) - Har bir so'rovda faylni jonli o'qish
        agar yol == "/" yoki yol == "/index.html" {
            html_sahifa = fayl_oqish("docs/index.html")
            javob = http_javob_html(200, html_sahifa)
            xabar_yubor(mijoz_fd, javob)
        } aks agar yol == "/yuklab-olish" yoki yol == "/yuklab-olish.html" yoki yol == "/download" yoki yol == "/download.html" {
            dl_sahifa = fayl_oqish("docs/yuklab-olish.html")
            javob = http_javob_html(200, dl_sahifa)
            xabar_yubor(mijoz_fd, javob)
        } aks agar yol == "/favicon.ico" {
            icon_fayl = fayl_oqish("docs/assets/icon.svg")
            javob = http_javob_qur(200, "image/svg+xml", icon_fayl)
            xabar_yubor(mijoz_fd, javob)
        } aks agar matn_boshlanishi(yol, "/assets/") {
            fayl_yoli = "docs" + yol
            agar fayl_bormi(fayl_yoli) {
                fayl_matn = fayl_oqish(fayl_yoli)
                mime = "application/octet-stream"
                agar matn_tugashi(yol, ".css") { mime = "text/css; charset=utf-8" }
                aks agar matn_tugashi(yol, ".js") { mime = "application/javascript; charset=utf-8" }
                aks agar matn_tugashi(yol, ".svg") { mime = "image/svg+xml" }
                aks agar matn_tugashi(yol, ".png") { mime = "image/png" }
                aks agar matn_tugashi(yol, ".ico") { mime = "image/x-icon" }
                aks agar matn_tugashi(yol, ".woff2") { mime = "font/woff2" }
                aks agar matn_tugashi(yol, ".ttf") { mime = "font/ttf" }
                aks agar matn_tugashi(yol, ".otf") { mime = "font/otf" }
                aks agar matn_tugashi(yol, ".json") { mime = "application/json; charset=utf-8" }
                javob = http_javob_qur(200, mime, fayl_matn)
                xabar_yubor(mijoz_fd, javob)
            } aks {
                javob = http_javob_404()
                xabar_yubor(mijoz_fd, javob)
            }
        } aks agar yol == "/install.sh" {
            install_sh = fayl_oqish("docs/install.sh")
            javob = http_javob_qur(200, "text/plain; charset=utf-8", install_sh)
            xabar_yubor(mijoz_fd, javob)
        } aks agar yol == "/install.ps1" {
            install_ps1 = fayl_oqish("docs/install.ps1")
            javob = http_javob_qur(200, "text/plain; charset=utf-8", install_ps1)
            xabar_yubor(mijoz_fd, javob)
        } aks agar matn_boshlanishi(yol, "/releases/") {
            rel_yoli = "docs" + yol
            agar fayl_bormi(rel_yoli) {
                rel_fayl = fayl_oqish(rel_yoli)
                javob = http_javob_qur(200, "application/octet-stream", rel_fayl)
                xabar_yubor(mijoz_fd, javob)
            } aks {
                javob = http_javob_404()
                xabar_yubor(mijoz_fd, javob)
            }
        } aks agar yol == "/api/salomatlik" {
            javob = http_javob_json(200, "{\"holat\":\"faol\",\"til\":\"Algo v1.5.0\",\"dvijok\":\"x86_64 Direct Syscalls\"}")
            xabar_yubor(mijoz_fd, javob)
        } aks agar yol == "/api/bajar" va metod == "POST" {
            tana = http_tana(sorov)
            agar uzunlik(tana) > 0 {
                fayl_yozish("/tmp/live_kod.algo", tana)
                tizim_buyruq("./bin/algo bajar /tmp/live_kod.algo > /tmp/live_chiqish.txt 2>&1")
                chiqish_matni = fayl_oqish("/tmp/live_chiqish.txt")
                javob = http_javob_matn(200, chiqish_matni)
                xabar_yubor(mijoz_fd, javob)
            } aks {
                javob = http_javob_json(400, "{\"xato\":\"Kod kiritilmadi\"}")
                xabar_yubor(mijoz_fd, javob)
            }
        } aks {
            javob = http_javob_404()
            xabar_yubor(mijoz_fd, javob)
        }
        
        ulanish_yop(mijoz_fd)
    }

    server_yop(server_fd)
    qaytar 0
}
